{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bank_transfers;Username=postgres;Password=postgres"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "Topic": "scheduled-transfers",
    "GroupId": "scheduled-transfer-workers"
  },
  "TransferRules": {
    "TimeZone": "America/Sao_Paulo",
    "DayStartHour": 6,
    "NightStartHour": 22,
    "DefaultDayHourlyAmountLimit": 10000,
    "DefaultDayHourlyAttemptLimit": 10,
    "DefaultNightHourlyAmountLimit": 1000,
    "DefaultNightHourlyAttemptLimit": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
